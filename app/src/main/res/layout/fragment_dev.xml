<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    android:id="@+id/admin_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/adminBg"
    tools:ignore="HardcodedText, VisualLintButtonSize"
    tools:context=".DevFragment">

    <!-- The Top Banner (Toolbar) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/greenTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Admin Screen"
        app:titleTextColor="@color/black" />

    <!-- The Stay Button -->
    <ImageButton
        android:id="@+id/button6"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="This button lets the user enter the admin screen"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="@+id/admin_toolbar"
        app:layout_constraintEnd_toEndOf="@+id/admin_toolbar"
        app:layout_constraintHorizontal_bias="0.7"
        app:layout_constraintStart_toStartOf="@+id/admin_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:tint="@color/greenTheme" />

    <!--TODO: Put this in a new fragment-->
    <!-- Log UI -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/admin_toolbar">

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="REPLACE ME?\n"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </ScrollView>

    <!--TODO-->
    <!-- This as well -->
    <Button
        android:id="@+id/logButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="log"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Page Controls -->
    <LinearLayout
        android:id="@+id/page_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left Arrow (Previous Page) -->
        <ImageButton
            android:id="@+id/btn_prev_page"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Previous Page"
            app:tint="@color/greenTheme"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <!-- Page Number Indicator -->
        <TextView
            android:id="@+id/tv_page_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="42dp"
            android:text="1"
            android:textColor="@color/greenTheme"
            android:textSize="25sp"
            android:textStyle="bold" />

        <!-- Right Arrow (Next Page) -->
        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Next Page"
            android:rotation="180"
            app:tint="@color/greenTheme"
            android:padding="12dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- 6 Buttons -->
    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="3"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/admin_toolbar"
        app:layout_constraintBottom_toTopOf="@id/page_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cell 1 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="Logs"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for Logs"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

        <!-- Cell 2 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="Audio Settings"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for Audio Settings"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

        <!-- Cell 3 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="File Marking"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_3"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for File Marking"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

        <!-- Cell 4 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="File Management"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_4"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for File Management"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

        <!-- Cell 5 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="Offline Mode"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_5"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for Offline Mode"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

        <!-- Cell 6 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp">

            <Button
                android:id="@+id/btn_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/adminBtn"
                android:elevation="6dp"
                app:cornerRadius="16dp"
                app:rippleColor="@color/ripple"
                android:text="Statistics"
                android:textAllCaps="false"
                android:textColor="@color/greenTheme"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/infoBtn_6"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle"
                android:src="@drawable/ic_info"
                android:contentDescription="Info for Statistics"
                app:tint="@color/greenTheme"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:elevation="7dp" />
        </FrameLayout>

    </GridLayout>

    <!-- A single bucket for all 6 sub-screens -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/dev_sub_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="20dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>