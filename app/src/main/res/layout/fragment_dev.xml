<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#222222"
    tools:ignore="HardcodedText, VisualLintButtonSize"
    tools:context=".FragmentDev">

    <!-- The Top Banner (Toolbar) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/admin_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#78da0b"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Admin Screen"
        app:titleTextColor="@color/black" />

    <!-- The Stay Checkmark -->
    <ImageButton
        android:id="@+id/button6"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="@+id/admin_toolbar"
        app:layout_constraintEnd_toEndOf="@+id/admin_toolbar"
        app:layout_constraintHorizontal_bias="0.94"
        app:layout_constraintStart_toStartOf="@+id/admin_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:tint="#78da0b" />

    <!-- HIDDEN LOG UI (Required for Kotlin to compile) -->
    <ScrollView
        android:id="@+id/logScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/admin_toolbar">

        <TextView
            android:id="@+id/logTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:text="Event Log Started...\n"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/logButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="log"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pagination Controls (Bottom Area) -->
    <LinearLayout
        android:id="@+id/pagination_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left Arrow (Previous Page) -->
        <ImageButton
            android:id="@+id/btn_prev_page"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Previous Page"
            app:tint="#78da0b"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <!-- Page Number Indicator -->
        <TextView
            android:id="@+id/tv_page_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="42dp"
            android:text="1"
            android:textColor="#78da0b"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Right Arrow (Next Page - Flipped programmatically!) -->
        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Next Page"
            android:rotation="180"
            app:tint="#78da0b"
            android:padding="12dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- 6 Big Buttons (Center Grid) -->
    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="3"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/admin_toolbar"
        app:layout_constraintBottom_toTopOf="@id/pagination_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/grid_btn_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 1"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grid_btn_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 2"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grid_btn_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 3"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grid_btn_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 4"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grid_btn_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 5"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/grid_btn_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:backgroundTint="#2C2C2C"
            android:elevation="6dp"
            app:cornerRadius="16dp"
            app:rippleColor="#5578da0b"
            android:text="Action 6"
            android:textAllCaps="false"
            android:textColor="#78da0b"
            android:textSize="22sp"
            android:textStyle="bold" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>